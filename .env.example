JWT_SECRET=replace-with-a-long-random-secret
# 上线必须：改成真实前端域名（如 https://your-domain.com），留空=同源无跨域
CORS_ORIGIN=

# Local SQLite fallback
DB_PATH=./data/gift_exchange.db

# 图片上传目录（阶段二G：先传后引用）。默认 ./data/uploads，一般无需修改。
# UPLOAD_DIR=./data/uploads

# WeChat CloudBase/MySQL mode, use these when the platform provides MySQL.
# MYSQL_ADDRESS=127.0.0.1:3306
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=gift_exchange
